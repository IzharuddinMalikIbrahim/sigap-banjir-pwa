{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,

        "module": "ESNext",
        "moduleResolution": "bundler",

        "allowJs": true,
        "noEmit": true,

        "jsx": "react-jsx",

        "strict": true,
        "noImplicitAny": true,

        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        "skipLibCheck": true,

        "baseUrl": ".",

        "paths": {
            "@/*": [
                "./resources/js/*"
            ]
        }
    },

    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.tsx"
    ]
}